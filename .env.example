# Port configuration (inside the container)
PORT=3000

# Your private API key from Resend (create a new one to replace the old, revoked key)
RESEND_API_KEY=re_yourResendApiKeyHere

# Secret token for API protection (keep the one you use for testing)
API_SECURE_TOKEN=c3079ca5b014ec9e1a0793eb2cd1ed975d4aec7b88a07ff166fcef3ac9b19cca

# Base URL of your service for generating correct links in emails
APP_BASE_URL=http://localhost:8089

# Secret key for encrypting and signing registration verification JWT tokens
# (Use a long, random string of characters)
JWT_SECRET=f3a8b4c2e6d19a7e5f80b13467c9d2e5a1b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7